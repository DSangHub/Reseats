# ---- server ----
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Public base URL of this API (used in webhook payload links)
PUBLIC_BASE_URL=http://localhost:8080

# ---- database (Supabase Postgres) ----
# Project Settings -> Database -> Connection string -> URI (use the pooler in serverless)
DATABASE_URL=postgresql://postgres:password@localhost:5432/reseats
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# ---- secrets ----
# 32-byte key, base64. Generate: openssl rand -base64 32
# Encrypts stored card-provider access tokens at rest.
ENCRYPTION_KEY=

# HMAC key used to hash merchant API keys before storage.
# Generate: openssl rand -base64 32
API_KEY_PEPPER=

# Signing secret for user session tokens (Supabase JWT secret if you use Supabase Auth).
SESSION_JWT_SECRET=

# ---- card providers ----
# Comma separated. Supported: stripe, mock
CARD_PROVIDERS=stripe,mock
DEFAULT_CARD_PROVIDER=stripe

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- outbound webhooks ----
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_TIMEOUT_MS=8000
# Set to false in serverless deploys and drive the queue from a cron worker instead.
WEBHOOK_WORKER_ENABLED=true
WEBHOOK_WORKER_INTERVAL_MS=5000

# ---- matching ----
# How far apart a card transaction and a POS receipt can be and still match.
MATCH_WINDOW_SECONDS=900
